# Copy to .env and fill in. Convex settings (CONVEX_DEPLOYMENT,
# NEXT_PUBLIC_CONVEX_URL) live in .env.local, which `npx convex dev` creates.
# CONVEX_SERVER_SECRET must match the value set with `npx convex env set`.
# On Vercel also set CONVEX_DEPLOY_KEY (production deploy key from the Convex dashboard).

ADMIN_PASSWORD="change-me"
SESSION_SECRET="a-long-random-string"
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CONVEX_SERVER_SECRET=""
